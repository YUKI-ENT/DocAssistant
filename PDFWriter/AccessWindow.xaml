<Window x:Class="PDFWriter.AccessWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Access カルテ連携" Width="1100" Height="760" MinWidth="850" MinHeight="580" WindowStartupLocation="CenterOwner" Closed="WindowClosed">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Background="#F3F5F8">
<Border DockPanel.Dock="Top" Background="#14263D" Padding="24,18"><StackPanel><TextBlock Text="Access カルテ連携" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="クライアントMDBに接続し、フォームの項目構造を確認します。" Foreground="#AEC0D4" Margin="0,6,0,0"/></StackPanel></Border>
<Border DockPanel.Dock="Top" Background="White" Padding="22,16"><StackPanel>
<TextBlock Text="電子カルテのクライアントMDB" Style="{StaticResource Label}"/>
<DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="MDBを選択…" Click="Browse"/><TextBox x:Name="DatabasePathBox" VerticalContentAlignment="Center" TextChanged="ConnectionInputChanged"/></DockPanel>
<WrapPanel Margin="0,12,0,0"><TextBlock Text="対象フォーム" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="FormNameBox" Width="190" Text="患者マスター" VerticalContentAlignment="Center" TextChanged="ConnectionInputChanged"/>
<Button x:Name="AttachButton" Content="開いているAccessに接続" Style="{StaticResource Primary}" Click="Attach"/>
<Button x:Name="ConnectButton" Content="MDBを開く・接続" Click="Connect"/>
<Button x:Name="RefreshButton" Content="再読み込み" Click="Refresh" IsEnabled="False"/><Button x:Name="OpenFormButton" Content="対象フォームを開く" Click="OpenForm" IsEnabled="False"/></WrapPanel>
<TextBlock x:Name="ConnectionStatus" Text="Access側でカルテを開き、同じMDBを選択して「開いているAccessに接続」を押してください。" TextWrapping="Wrap" Foreground="#52647B" Margin="0,12,0,0"/>
</StackPanel></Border>
<Border DockPanel.Dock="Bottom" Background="White" Padding="20,12"><DockPanel>
<Button DockPanel.Dock="Right" Content="閉じる" Click="CloseWindow"/>
<Button x:Name="CopyButton" DockPanel.Dock="Right" Content="構造をコピー" Click="CopyStructure" IsEnabled="False"/>
<StackPanel VerticalAlignment="Center"><TextBlock Text="患者情報は素材欄へ取得し、コピーしてPDFの文字枠へ貼り付けます。" Foreground="#65768B" FontSize="12"/><TextBlock Text="この画面を閉じてもAccessは開いたままです。" Foreground="#65768B" FontSize="12" Margin="0,3,0,0"/></StackPanel>
</DockPanel></Border>
<Grid Margin="22,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock x:Name="OpenFormsLabel" Text="開いているフォーム：未接続" Foreground="#52647B" TextWrapping="Wrap" Margin="0,0,0,10"/>
<DataGrid x:Name="ControlGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F5" BorderBrush="#D4DDE7" RowHeaderWidth="0" RowHeight="27" ColumnHeaderHeight="32" AlternatingRowBackground="#F8FAFC" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader">
<DataGrid.Columns>
<DataGridTextColumn Header="フォーム / サブフォーム" Binding="{Binding FormPath}" Width="210"/>
<DataGridTextColumn Header="コントロール名" Binding="{Binding Name}" Width="180"/>
<DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="130"/>
<DataGridTextColumn Header="連結先（ControlSource）" Binding="{Binding ControlSource}" Width="*" MinWidth="220"/>
<DataGridTextColumn Header="サブフォーム元" Binding="{Binding SourceObject}" Width="160"/>
</DataGrid.Columns></DataGrid>
<ScrollViewer Grid.Column="1" Grid.RowSpan="3" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="患者情報・素材テキスト" FontSize="16" FontWeight="SemiBold"/><Button x:Name="PatientButton" Content="現在の患者情報を取得" Click="ReadPatient" IsEnabled="False" Margin="0,10,0,8"/><TextBox x:Name="MaterialBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="240"/><Button x:Name="MaterialCopyButton" Content="素材をコピー" Click="CopyMaterial"/><TextBlock Text="患者を切り替えたら再取得してください。生年月日と性別も表示します。" TextWrapping="Wrap" Foreground="#65768B" Margin="0,8,0,0"/></StackPanel></ScrollViewer><TextBox x:Name="NotesBox" Grid.Row="2" Text="接続後、フォーム要素と接続状況を表示します。" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Background="#EEF5F7"/>
</Grid>
</DockPanel></Window>
