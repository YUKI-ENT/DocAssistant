<Window x:Class="DocAssistant.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DocAssistant の設定" Width="690" Height="700" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="28" Background="#F3F5F8">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="ワークスペースの設定" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="保存先と、すぐに使えるテンプレートを登録します。" Foreground="#75859A" Margin="0,8,0,24"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="キャンセル" IsCancel="True"/><Button Content="設定を保存" Style="{StaticResource Primary}" Click="Save"/></StackPanel>
<StackPanel>
<TextBlock Text="既定の保存先" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="参照…" Click="BrowseSave"/><TextBox x:Name="SaveFolder" VerticalContentAlignment="Center"/></DockPanel>
<TextBlock Text="テンプレートフォルダ（直下のPDFを一覧に表示）" Style="{StaticResource Label}" Margin="0,20,0,5"/><DockPanel><Button DockPanel.Dock="Right" Content="参照…" Click="BrowseTemplates"/><TextBox x:Name="TemplateFolder" VerticalContentAlignment="Center" LostFocus="FolderEdited"/></DockPanel>
<TextBlock Text="個別に登録するPDF（別のフォルダからも登録できます）" Style="{StaticResource Label}" Margin="0,20,0,5"/>
<ListBox x:Name="RegisteredFiles" Height="135" BorderBrush="#D4DDE7" DisplayMemberPath="Path" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="PDFを追加" Click="AddTemplate"/><Button Content="登録を解除" Click="RemoveTemplate"/></StackPanel>
<TextBlock Text="起動時に表示するテンプレート" Style="{StaticResource Label}" Margin="0,16,0,5"/><ComboBox x:Name="StartupTemplate" DisplayMemberPath="Name"/>
<TextBlock Text="「表示しない」を選ぶと、起動後にテンプレートを選択できます。&#10;PDF本体は移動せず、ファイルの場所を登録します。" Foreground="#7D8A9D" FontSize="12" Margin="0,10,0,0"/>
</StackPanel>
</DockPanel></Window>
