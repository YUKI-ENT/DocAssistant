<WrapPanel><Button x:Name="ReferralOlder" Content="◀ 前の紹介状" Click="OlderReferral" IsEnabled="False"/><Button x:Name="ReferralNewer" Content="次の紹介状 ▶" Click="NewerReferral" IsEnabled="False"/><Button x:Name="ReferralReload" Content="再取得" Click="ReloadReferrals"/><Button x:Name="ReferralNew" Content="新規" Click="NewReferral" IsEnabled="False"/><Button x:Name="ReferralCopy" Content="コピーして新規" Click="CopyReferral" IsEnabled="False"/><Button x:Name="ReferralSave" Content="Accessに保存" Click="SaveReferral" Style="{StaticResource Primary}" IsEnabled="False"/><Button x:Name="ReferralOpenAccess" Content="Accessで紹介状を開く" Click="OpenReferralInAccess" IsEnabled="False" ToolTip="未保存の変更を保存し、Accessの紹介状フォームを開きます。"/></WrapPanel>
<TextBlock Text="{Binding Text, ElementName=ReferralStatus}" TextWrapping="Wrap" Foreground="#087F8C" Margin="0,8,0,0"/>
<TextBlock TextWrapping="Wrap" x:Name="ReferralPosition" Text="未取得" Foreground="#64748B" FontSize="15" Margin="0,8,0,0"/>
</StackPanel></Border>
<Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="18,10"><StackPanel>
<TextBlock x:Name="ReferralStatus" Text="紹介状タブを開くと、表示中患者の紹介状を読み取ります。" Foreground="#087F8C" TextWrapping="Wrap"/>
<TextBlock Text="保存先はAccessの紹介状テーブルです。印刷はAccess側で行います。" FontSize="14" Foreground="#64748B" TextWrapping="Wrap" Margin="0,5,0,0"/>
</StackPanel></Border>
<ScrollViewer x:Name="ReferralScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18,16">
<Border x:Name="ReferralPatientWarning" Visibility="Collapsed" Background="#FFF4DC" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="カルテ側の患者が変わっています。下書きは元の患者の内容として保持しています。" TextWrapping="Wrap" Foreground="#805A16"/><Button Content="表示中の患者へ切替" Click="ReloadReferrals" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
<StackPanel x:Name="ReferralFields" IsEnabled="False">
<TextBlock Text="日付" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><DatePicker x:Name="ReferralDate" SelectedDateChanged="ReferralChanged" Width="210" HorizontalAlignment="Left" Margin="0,0,0,14"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="紹介先病院" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><ComboBox x:Name="ReferralDestination1" Style="{x:Null}" ItemTemplate="{StaticResource ReferralSuggestionTemplate}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value" StaysOpenOnEdit="True" MinHeight="40" Margin="0,0,0,12" TextBoxBase.TextChanged="ReferralChanged"/></StackPanel>
<StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="診療科" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><ComboBox x:Name="ReferralDestination2" Style="{x:Null}" ItemTemplate="{StaticResource ReferralSuggestionTemplate}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value" StaysOpenOnEdit="True" MinHeight="40" Margin="0,0,0,12" TextBoxBase.TextChanged="ReferralChanged"/></StackPanel>
<StackPanel Grid.Column="2" Margin="0,0,0,0"><TextBlock Text="紹介先医師（敬称自動付加）" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><ComboBox x:Name="ReferralDoctor" Style="{x:Null}" ItemTemplate="{StaticResource ReferralSuggestionTemplate}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value" StaysOpenOnEdit="True" MinHeight="40" Margin="0,0,0,8" TextBoxBase.TextChanged="ReferralChanged"/></StackPanel>
</Grid>
<TextBlock x:Name="ReferralChoicesHint" Text="候補は全患者の過去の紹介状から使用頻度順に表示します。直接入力もできます。" TextWrapping="Wrap" Foreground="#64748B" FontSize="14" Margin="0,0,0,18"/>
<TextBlock Text="傷病名" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><ComboBox x:Name="ReferralDiagnosis" Style="{x:Null}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MinHeight="40" TextBoxBase.TextChanged="ReferralChanged" Margin="0,0,0,14"/>
<TextBlock Text="紹介目的" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><ComboBox x:Name="ReferralPurpose" Style="{x:Null}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" MinHeight="40" TextBoxBase.TextChanged="ReferralChanged" Margin="0,0,0,14"/>
<TextBlock Text="治療" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><TextBox x:Name="ReferralTreatment" AcceptsReturn="True" TextWrapping="Wrap" Height="66" VerticalScrollBarVisibility="Auto" TextChanged="ReferralChanged" Margin="0,0,0,14"/>
<TextBlock Text="検査" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="定型句" VerticalAlignment="Center" Margin="0,0,8,0"/>
<ComboBox x:Name="ReferralTemplate" Grid.Column="1" Style="{x:Null}" MinHeight="40" MaxDropDownHeight="300" ToolTip="検査欄へ追加するテンプレート"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource FirstLineConverter}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="500" ToolTip="{Binding}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="文頭" ToolTip="文頭に定型句を追加します" Tag="Start" Click="InsertReferralTemplate"/><Button Content="文末" ToolTip="文末に定型句を追加します" Tag="End" Click="InsertReferralTemplate"/><Button Content="カーゾル" ToolTip="カーソル位置に定型句を追加します" Tag="Cursor" Click="InsertReferralTemplate"/></StackPanel></Grid>
<Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="処方薬" VerticalAlignment="Center" Margin="0,0,8,0"/>
<ComboBox x:Name="ReferralMedication" Grid.Column="1" Style="{x:Null}" MinHeight="40" MaxDropDownHeight="300" SelectionChanged="ReferralMedicationSelected" ToolTip="処方日と投薬内容を選択（新しい順・全枝番）"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Content}" MaxWidth="650"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<Button x:Name="ReferralAddMedication" Grid.Column="2" Content="文末追加" Click="AddReferralMedication" IsEnabled="False"/>
</Grid>
<TextBox x:Name="ReferralTests" AcceptsReturn="True" TextWrapping="Wrap" Height="280" VerticalScrollBarVisibility="Auto" TextChanged="ReferralChanged" Margin="0,0,0,14"/>
<StackPanel Orientation="Horizontal"><TextBlock Text="備考" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="ReferralAddAttention" Content="注意リスト追加" Click="AddReferralAttention" Margin="12,0,0,4"/></StackPanel><TextBox x:Name="ReferralRemarks" AcceptsReturn="True" TextWrapping="Wrap" Height="66" VerticalScrollBarVisibility="Auto" TextChanged="ReferralChanged" Margin="0,0,0,14"/>
<TextBlock Text="検査結果" Style="{StaticResource Label}" FontSize="16" TextWrapping="Wrap"/><TextBox x:Name="ReferralTestResults" AcceptsReturn="True" TextWrapping="Wrap" Height="66" VerticalScrollBarVisibility="Auto" TextChanged="ReferralChanged" Margin="0,0,0,14"/>
<Expander Header="この紹介状に登録された処方（読み取り専用）" IsExpanded="True" Margin="0,0,0,14">
<StackPanel Margin="0,6,0,0"><TextBlock Text="過去の紹介状に保存された薬名・数量・単位です。処方日は保存されていません。" FontSize="14" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,6"/>
<TextBox x:Name="ReferralSavedPrescription" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="66" MaxHeight="200" VerticalScrollBarVisibility="Auto" Background="#EEF2F6"/>
</StackPanel></Expander>

</StackPanel></StackPanel></ScrollViewer>
</DockPanel></TabItem>
<TabItem Header="診断書作成"><Grid Background="#F3F5F8"><Border Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="12" Padding="32" Margin="28" VerticalAlignment="Center" MaxWidth="520"><StackPanel><TextBlock Text="診断書作成" FontSize="24" Foreground="#14263D" FontWeight="SemiBold"/><TextBlock Text="準備中" Foreground="#087F8C" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="書式や必要事項に合わせて、診断書を作成する画面です。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,16,0,0"/><TextBlock Text="文書生成・編集機能は今後追加予定です。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid></TabItem>
</TabControl>
</Grid>
</Grid>
</DockPanel></Window>
