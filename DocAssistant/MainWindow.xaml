<Window x:Class="DocAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DocAssistant — ハイブリッド記入" Width="1740" Height="940" MinWidth="1380" MinHeight="700" Closing="OnClosing" PreviewKeyDown="EditorKeyDown">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Background="#F3F5F8">
<Border DockPanel.Dock="Top" Background="#14263D" Padding="23,16"><DockPanel>
<StackPanel DockPanel.Dock="Left"><TextBlock x:Name="AppName" Text="DocAssistant" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="文章はキーボードで。図は自由に。" Foreground="#9FB3C9" FontSize="11" Margin="0,3,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Access  カルテ連携" Click="OpenAccess"/><Button Content="⚙  設定" Click="OpenSettings"/></StackPanel>
<TextBlock x:Name="DocumentTitle" Text="ダイナミクス連携文書作成支援ツール" Foreground="#D7E3EE" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" Margin="20,0"/>
</DockPanel></Border>
<Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="18,9"><DockPanel>
<TextBlock DockPanel.Dock="Right" Text="Ctrl+Z 取り消し  /  Ctrl+Y やり直し" Foreground="#8A98A9" FontSize="11"/>
<TextBlock x:Name="Status" Text="PDFまたはテンプレートを選択してください。" Foreground="#52647B"/>
</DockPanel></Border>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="240"/><ColumnDefinition Width="6"/><ColumnDefinition Width="400" MinWidth="320"/><ColumnDefinition Width="6"/><ColumnDefinition x:Name="ChartColumn" Width="380" MinWidth="280"/></Grid.ColumnDefinitions>
<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#CCD7E3" Cursor="SizeWE" ToolTip="ドラッグしてカルテ情報の幅を調整"/>
<GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#CCD7E3"/>
<Border x:Name="LlmPane" Grid.Column="2" Background="#F8FAFC" Padding="14">
<DockPanel>
<TextBlock DockPanel.Dock="Top" Text="AIアシスタント" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
<TextBlock x:Name="LlmStatus" DockPanel.Dock="Bottom" Text="接続先を設定してモデルを取得してください。" TextWrapping="Wrap" Foreground="#087F8C" Margin="0,8"/>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<StackPanel x:Name="LlmInputs">
<Expander x:Name="LlmConnectionExpander" Header="接続設定" IsExpanded="False"><Border BorderBrush="#71AEB2" BorderThickness="3,0,0,0" Background="#EFF6F7" Padding="12,8,8,8" Margin="10,8,0,12"><StackPanel>
<TextBlock Text="アドレス（例 http://localhost）" Style="{StaticResource Label}"/>
<TextBox x:Name="LlmAddress"/>
<Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ポート" Style="{StaticResource Label}"/><TextBox x:Name="LlmPort" Margin="0,0,8,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="APIキー（任意・保存なし）" Style="{StaticResource Label}"/><PasswordBox x:Name="LlmKey" Padding="8,6"/></StackPanel></Grid>
<TextBlock Text="Ollama: 11434 / LM Studio: 1234" Foreground="#64748B" FontSize="11"/>
<WrapPanel><Button Content="接続設定を保存" Click="SaveLlmSettings"/><Button Content="モデル取得" Click="LoadLlmModels"/></WrapPanel>
</StackPanel></Border></Expander>
<TextBlock Text="モデル一覧" Style="{StaticResource Label}"/><ComboBox x:Name="LlmModels"/>
<TextBlock Text="プロンプト" Style="{StaticResource Label}"/><ComboBox x:Name="LlmPrompts" DisplayMemberPath="Name" SelectionChanged="LlmPromptChanged"/>
<Expander Header="プロンプトを編集" IsExpanded="False" Margin="0,8,0,0">
<StackPanel Margin="18,10,0,0"><TextBlock Text="タイトル" Style="{StaticResource Label}"/><TextBox x:Name="LlmPromptName" Margin="0,0,0,8"/><TextBlock Text="プロンプト内容" Style="{StaticResource Label}"/>
<TextBox x:Name="LlmPromptText" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
<WrapPanel><Button Content="保存" Click="SaveLlmPrompt"/><Button Content="追加" Click="AddLlmPrompt"/><Button Content="削除" Click="DeleteLlmPrompt"/></WrapPanel></StackPanel></Expander>
<TextBlock Text="ペイロード" Style="{StaticResource Label}" Margin="0,8,0,6"/>
<WrapPanel x:Name="LlmPayloadOptions" Orientation="Horizontal"/><TextBlock Text="対象期間（全項目共通・開始日から今日まで）" Style="{StaticResource Label}" Margin="0,10,0,5"/><ComboBox x:Name="LlmPeriod" SelectionChanged="LlmPeriodChanged" Margin="0,0,0,6"/><DatePicker x:Name="LlmStartDate" SelectedDateChanged="LlmStartDateChanged"/><TextBlock x:Name="LlmPeriodHint" Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
<TextBlock Text="所見はAccessの表示範囲内の保存済み記録。投薬・処置は各テーブルの保存済み記録。当日分は同じ受診の当日表示を優先し、空欄なら保存済み履歴を使用します。" TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="0,8"/>
</StackPanel>
<WrapPanel Margin="0,8"><Button x:Name="LlmGenerate" Content="生成" Click="GenerateLlm" Style="{StaticResource Primary}"/><Button x:Name="LlmCancel" Content="中止" IsEnabled="False" Click="CancelLlm"/><Button Content="結果をコピー" Click="CopyLlmResult"/></WrapPanel>
<TextBlock Text="生成結果（内容を確認して使用してください）" Style="{StaticResource Label}"/>
<RichTextBox x:Name="LlmResult" IsReadOnly="True" MinHeight="180" MaxHeight="500" VerticalScrollBarVisibility="Auto"/>
</StackPanel></ScrollViewer>
</DockPanel></Border>
<Border Grid.Column="4" Background="#EEF2F6" Padding="14">
<Border.Resources><Style x:Key="ChartCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE3EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,12"/></Style></Border.Resources>
<DockPanel>
<StackPanel DockPanel.Dock="Top">
<DockPanel><Button x:Name="ChartRefreshButton" DockPanel.Dock="Right" Content="再取得" Click="RefreshChart" Padding="10,5"/><TextBlock Text="カルテ情報" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<TextBlock x:Name="ChartStatus" Foreground="#087F8C" TextWrapping="Wrap" Margin="0,10,0,12"/>
</StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="文字を選択 → PDFへドラッグして挿入。Ctrl+Cでコピー。" Foreground="#7D8A9D" FontSize="11" TextWrapping="Wrap"/>
<ScrollViewer x:Name="MedicationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel>
<Border Style="{StaticResource ChartCard}" Background="#F8FAFD"><StackPanel>
<TextBlock Text="患者基本情報" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
<Grid x:Name="PatientFieldsGrid"/>
<TextBlock x:Name="ChartPlaceholder" Text="Accessで患者を表示すると、ここに情報が表示されます。" Foreground="#8A98A9" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Style="{StaticResource ChartCard}" Background="#F8FAFD"><StackPanel>
<TextBlock Text="当日所見" FontWeight="SemiBold" FontSize="15"/>
<TextBlock x:Name="ChartDraftStatus" Foreground="#7D8A9D" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
<RichTextBox x:Name="ChartDraft" MaxHeight="180" MinHeight="50" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" FontSize="14"/>
<StackPanel Margin="0,10,0,0">
<Border BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="0,6">
<StackPanel><Expander x:Name="TodayBasicExpander" Header="基本診療" IsEnabled="False" HorizontalContentAlignment="Stretch" FontSize="12" Foreground="#33465C">
<RichTextBox x:Name="ChartTodayBasic" MaxHeight="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="4" FontSize="13"/>
</Expander><TextBlock x:Name="ChartTodayBasicStatus" FontSize="11" Foreground="#7D8A9D" TextWrapping="Wrap" Margin="24,2,0,0" Visibility="Collapsed"/></StackPanel></Border>
<Border BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="0,6">
<StackPanel><Expander x:Name="TodayMedicationExpander" Header="投薬" IsEnabled="False" HorizontalContentAlignment="Stretch" FontSize="12" Foreground="#33465C">
<RichTextBox x:Name="ChartTodayMedication" MaxHeight="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="4" FontSize="13"/>
</Expander><TextBlock x:Name="ChartTodayMedicationStatus" FontSize="11" Foreground="#7D8A9D" TextWrapping="Wrap" Margin="24,2,0,0" Visibility="Collapsed"/></StackPanel></Border>
<Border BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="0,6">
<StackPanel><Expander x:Name="TodayTestsExpander" Header="検査" IsEnabled="False" HorizontalContentAlignment="Stretch" FontSize="12" Foreground="#33465C">
<RichTextBox x:Name="ChartTodayTests" MaxHeight="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="4" FontSize="13"/>
</Expander><TextBlock x:Name="ChartTodayTestsStatus" FontSize="11" Foreground="#7D8A9D" TextWrapping="Wrap" Margin="24,2,0,0" Visibility="Collapsed"/></StackPanel></Border>
<Border BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="0,6">
<StackPanel><Expander x:Name="TodayProceduresExpander" Header="処置" IsEnabled="False" HorizontalContentAlignment="Stretch" FontSize="12" Foreground="#33465C">
<RichTextBox x:Name="ChartTodayProcedures" MaxHeight="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="4" FontSize="13"/>
</Expander><TextBlock x:Name="ChartTodayProceduresStatus" FontSize="11" Foreground="#7D8A9D" TextWrapping="Wrap" Margin="24,2,0,0" Visibility="Collapsed"/></StackPanel></Border>
<Border BorderBrush="#DCE3EB" BorderThickness="0,1,0,0" Padding="0,6">
<StackPanel><Expander x:Name="TodayInjectionsExpander" Header="注射" IsEnabled="False" HorizontalContentAlignment="Stretch" FontSize="12" Foreground="#33465C">
<RichTextBox x:Name="ChartTodayInjections" MaxHeight="180" IsReadOnly="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="4" FontSize="13"/>
</Expander><TextBlock x:Name="ChartTodayInjectionsStatus" FontSize="11" Foreground="#7D8A9D" TextWrapping="Wrap" Margin="24,2,0,0" Visibility="Collapsed"/></StackPanel></Border>
</StackPanel>
</StackPanel></Border>
<Border x:Name="VisitHistoryCard" Background="#F8FAFD" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12" MinHeight="76"><StackPanel>
<TextBlock Text="受診履歴" Foreground="#33465C" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,10"/>
<TextBlock x:Name="ChartNotesStatus" Foreground="#7D8A9D" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
<StackPanel x:Name="MedicationDays"/>
</StackPanel></Border>
</StackPanel></ScrollViewer>
</DockPanel></Border>
<TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabChanged" Background="#F3F5F8" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
<TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#64748B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#E8EDF3" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="22,12" Margin="0,0,2,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="White"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#087F8C"/><Setter Property="Foreground" Value="#14263D"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#F8FAFC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
<TabItem x:Name="PdfEditorTab" Header="PDF編集"><DockPanel>
<Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E6EE" BorderThickness="0,0,0,1" Padding="18,12">
<StackPanel><WrapPanel VerticalAlignment="Center">
<Button Content="PDFを開く" Click="OpenPdf"/><Button Content="編集を開く" Click="OpenProject"/>
<Button Content="保存" Click="SaveProject" Style="{StaticResource Primary}"/><Button Content="印刷 / PDF出力" Click="Print"/>
<CheckBox x:Name="PrintInk" Content="手書き・図形も印刷" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"/>
</WrapPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="TEMPLATE / テンプレート" Style="{StaticResource Label}"/><ComboBox x:Name="TemplateBox" MinWidth="220" MaxWidth="360" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="TemplateChanged"/></StackPanel></StackPanel>
</Border>
<Border DockPanel.Dock="Left" Width="166" Background="White" BorderBrush="#E0E6EE" BorderThickness="0,0,1,0" Padding="12,20">
<DockPanel>
<StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,12"/><Button x:Name="UndoButton" Content="↶  取り消し" Click="UndoClick"/><Button x:Name="RedoButton" Content="↷  やり直し" Click="RedoClick"/><TextBlock Text="長方形で囲んで選択。&#10;Deleteで選択項目を削除。" Foreground="#8A98A9" FontSize="11" Margin="4,12" TextWrapping="Wrap"/></StackPanel>
<StackPanel><TextBlock Text="編集ツール" Style="{StaticResource Label}" Margin="14,0,0,10"/>
<RadioButton x:Name="TextTool" Content="T   文字入力" Style="{StaticResource Tool}" GroupName="Mode" Tag="Text" IsChecked="True" Checked="ModeChanged"/>
<RadioButton x:Name="SelectTool" Content="▧   選択・移動" Style="{StaticResource Tool}" GroupName="Mode" Tag="Select" Checked="ModeChanged"/>
<RadioButton Content="✎   ペン" Style="{StaticResource Tool}" GroupName="Mode" Tag="Ink" Checked="ModeChanged"/>
<RadioButton Content="⌫   消しゴム" Style="{StaticResource Tool}" GroupName="Mode" Tag="Erase" Checked="ModeChanged"/>
<Separator Margin="10,14"/>
<TextBlock Text="図形 / 塗りつぶしなし" Style="{StaticResource Label}" Margin="14,0,0,6"/>
<RadioButton Content="□   長方形" Style="{StaticResource Tool}" GroupName="Mode" Tag="Rectangle" Checked="ModeChanged"/>
<RadioButton Content="○   楕円" Style="{StaticResource Tool}" GroupName="Mode" Tag="Ellipse" Checked="ModeChanged"/>
<RadioButton Content="╱   直線" Style="{StaticResource Tool}" GroupName="Mode" Tag="Line" Checked="ModeChanged"/>
</StackPanel></DockPanel></Border>
<Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="18,12" BorderBrush="#E0E6EE" BorderThickness="0,0,0,1">
<WrapPanel>
<StackPanel Width="112" Margin="0,0,8,0"><TextBlock Text="表示ページ" Style="{StaticResource Label}"/><TextBlock x:Name="PageIndicator" Text="PAGE  — / —" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0"/></StackPanel>
<StackPanel><TextBlock Text="フォント" Style="{StaticResource Label}"/><ComboBox x:Name="FontFamilyBox" Width="180" SelectionChanged="TextStyleChanged"/></StackPanel>
<StackPanel><TextBlock Text="文字サイズ" Style="{StaticResource Label}"/><ComboBox x:Name="FontSizeBox" Width="65" SelectionChanged="TextStyleChanged"/></StackPanel>
<StackPanel><TextBlock Text="文字・描画の色" Style="{StaticResource Label}"/><ComboBox x:Name="ColorBox" Width="100" SelectionChanged="ColorChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" Background="{Binding Hex}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
<StackPanel><TextBlock Text="ペン・図形の太さ" Style="{StaticResource Label}"/><ComboBox x:Name="ThicknessBox" Width="78" SelectionChanged="LineStyleChanged"/></StackPanel>
<StackPanel><TextBlock Text="図形の線種" Style="{StaticResource Label}"/><ComboBox x:Name="DashBox" Width="82" SelectionChanged="LineStyleChanged"><ComboBoxItem Content="実線"/><ComboBoxItem Content="点線"/></ComboBox></StackPanel>
<StackPanel Margin="8,0,14,0"><TextBlock Text="表示倍率" Style="{StaticResource Label}"/><DockPanel><TextBlock x:Name="ZoomLabel" Text="100%" Width="40" VerticalAlignment="Center"/><Slider x:Name="Zoom" Minimum=".5" Maximum="2" Value="1" Width="100" VerticalAlignment="Center" ValueChanged="ZoomChanged"/></DockPanel></StackPanel>
</WrapPanel></Border>
<Grid><ScrollViewer x:Name="DocumentScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="DocumentScrolled"><StackPanel x:Name="Pages" HorizontalAlignment="Center" Margin="28,8,28,30"><StackPanel.LayoutTransform><ScaleTransform x:Name="PageScale"/></StackPanel.LayoutTransform></StackPanel></ScrollViewer>
<StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="PDF + あなたの書き込み" FontSize="27" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock Text="テンプレートを選ぶか、PDFを開いて始めましょう。" Foreground="#7D8A9D" Margin="0,16,0,24"/><Button Content="PDFを開く" Click="OpenPdf" Style="{StaticResource Primary}" HorizontalAlignment="Center"/></StackPanel></Grid></DockPanel></TabItem>
<TabItem Header="紹介状作成"><Grid Background="#F3F5F8"><Border Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="12" Padding="32" Margin="28" VerticalAlignment="Center" MaxWidth="520"><StackPanel><TextBlock Text="紹介状作成" FontSize="24" Foreground="#14263D" FontWeight="SemiBold"/><TextBlock Text="準備中" Foreground="#087F8C" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="紹介目的や診療情報をもとに、紹介状を作成する画面です。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,16,0,0"/><TextBlock Text="文書生成・編集機能は今後追加予定です。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid></TabItem>
<TabItem Header="診断書作成"><Grid Background="#F3F5F8"><Border Background="White" BorderBrush="#DCE3EB" BorderThickness="1" CornerRadius="12" Padding="32" Margin="28" VerticalAlignment="Center" MaxWidth="520"><StackPanel><TextBlock Text="診断書作成" FontSize="24" Foreground="#14263D" FontWeight="SemiBold"/><TextBlock Text="準備中" Foreground="#087F8C" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="書式や必要事項に合わせて、診断書を作成する画面です。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,16,0,0"/><TextBlock Text="文書生成・編集機能は今後追加予定です。" Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid></TabItem>
</TabControl>
</Grid>
</DockPanel></Window>
